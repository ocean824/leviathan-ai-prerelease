{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://knowledge/vault-template/schema/note.schema.json",
  "schema_version": 1,
  "title": "Leviathan vault note properties v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "note_id", "note_type", "title", "status", "trust_label", "created_at_utc_ns", "updated_at_utc_ns", "ingest", "methodology", "asset", "regime", "source_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "note_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "note_type": {"enum": ["moc", "index", "strategy", "research", "market-structure", "trade-journal", "post-mortem", "source-lineage"]},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "archived"]},
    "trust_label": {"enum": ["project-source", "operator-authored", "external-untrusted", "agent-generated-unreviewed"]},
    "created_at_utc_ns": {"type": "integer", "minimum": 0, "maximum": 253402300799999999999},
    "updated_at_utc_ns": {"type": "integer", "minimum": 0, "maximum": 253402300799999999999},
    "ingest": {"type": "boolean"},
    "methodology": {"$ref": "#/$defs/taxonomy"},
    "asset": {"$ref": "#/$defs/taxonomy"},
    "regime": {"$ref": "#/$defs/taxonomy"},
    "tags": {"$ref": "#/$defs/taxonomy"},
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
    "related_note_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
  },
  "$defs": {
    "taxonomy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_class", "locator", "section", "sha256"],
      "properties": {
        "authority_class": {"enum": ["project-prd", "project-adr", "project-spec"]},
        "locator": {"type": "string", "pattern": "^(project|codespring-prd)://"},
        "section": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
