# LEVIATHAN AI — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Core ---
LEVIATHAN_ENV=development
LEVIATHAN_OPERATING_MODE=research          # research | advisory | semi_auto | full_auto | prop_firm | recovery | signal_only
LEVIATHAN_API_HOST=127.0.0.1
LEVIATHAN_API_PORT=8000

# --- Storage ---
LEVIATHAN_DATABASE_URL=postgresql+asyncpg://leviathan:leviathan@localhost:5432/leviathan
LEVIATHAN_REDIS_URL=redis://localhost:6379/0

# --- Risk governance (sovereign) ---
# SHA-256 of infra/risk/risk_governance.lock.yaml — guardian refuses order routing on mismatch
LEVIATHAN_RISK_LOCK_SHA256=

# --- Market data providers (Phase 3+) ---
POLYGON_API_KEY=
UNUSUAL_WHALES_API_KEY=

# --- Model providers (Phase 4+) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
