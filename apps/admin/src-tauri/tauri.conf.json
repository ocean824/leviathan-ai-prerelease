{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leviathan Admin",
  "version": "0.1.0",
  "identifier": "com.xyrasystems.leviathanai.admin",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leviathan Admin",
        "width": 1360,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://leviathan-licensing-worker.ocean824.workers.dev; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: c5064c7ad4bf454c\nRWTFBkx61L9FTBoisNZV5Fruk+DlVFDvQSnh6uIfGoxM0UGsN7s2pDjW",
      "endpoints": ["https://leviathan-release-feed.ocean824.workers.dev/v1/updates/admin/{{target}}/{{arch}}/{{current_version}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
