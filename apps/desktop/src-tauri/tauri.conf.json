{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leviathan AI",
  "version": "0.1.0",
  "identifier": "com.xyrasystems.leviathanai",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/sidecar/"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: c5064c7ad4bf454c\nRWTFBkx61L9FTBoisNZV5Fruk+DlVFDvQSnh6uIfGoxM0UGsN7s2pDjW",
      "endpoints": [
        "https://releases.invalid/v1/updates/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
